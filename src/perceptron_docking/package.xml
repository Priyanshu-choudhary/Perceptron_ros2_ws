<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>perceptron_docking</name>
  <version>1.0.0</version>
  <description>Precision ArUco-based self docking system for Perceptron robot in ROS 2 Humble</description>
  <maintainer email="dev@todo.todo">Perceptron Developer</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_srvs</depend>
  <depend>nav2_msgs</depend>
  <!-- NOT declared: perceptron_navigation. docking_simulation.launch.py
       includes its navigation.launch.py, but perceptron_navigation already
       exec_depends on this package (nav_simulation pulls in docking), and
       colcon cannot order a cycle. The include is launch-time only and both
       packages are always installed together, so this stays undeclared. The
       controller itself depends only on the nav2_msgs action above. -->
  <depend>cv_bridge</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
