<?xml version="1.0" ?>
<!-- GENERATED by tools/gen_lunar_arena.py - edit that and re-run. -->
<sdf version="1.6">
  <model name="lunar_terrain">
    <static>true</static>
    <link name="link">
      <!--
        A MESH, not a heightmap, and the reason is measured rather than stylistic.
        ODE collides a heightfield by scanning every cell inside the other
        geom's bounding box. A lidar ray's bounding box spans the arena, so one
        scan costs hundreds of thousands of cell tests and gzserver never
        reaches its first physics step. The same terrain as a triangle mesh goes
        through OPCODE's AABB tree instead and runs at real time. See
        write_collision_stl() in tools/gen_lunar_arena.py for the numbers.
        The visual below stays a heightmap; visuals are never collided.
      -->
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://lunar_terrain/meshes/lunar_terrain_collision.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          <contact><ode><kp>1e6</kp><kd>100</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <heightmap>
            <use_terrain_paging>false</use_terrain_paging>
            <sampling>2</sampling>
            <texture>
              <diffuse>file://media/materials/textures/dirt_diffusespecular.png</diffuse>
              <normal>file://media/materials/textures/flat_normal.png</normal>
              <size>1</size>
            </texture>
            <uri>model://lunar_terrain/materials/textures/lunar_heightmap.png</uri>
            <size>9.0 5.0 0.5</size>
            <pos>4.500 2.500 -0.2510</pos>
          </heightmap>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
