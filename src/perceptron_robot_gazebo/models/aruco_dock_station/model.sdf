<?xml version="1.0" ?>
<!--
  ArUco docking station, DICT_5X5_250 id 42.

  The marker faces the model's +X axis, so place it in the world rotated to
  look at the robot (yaw = pi if the robot approaches from -X).

  Texture geometry matters: aruco_marker_42.png is 500x500 px and the black
  marker square occupies the middle 400 px (80%). So a 0.1875 m plate renders a
  0.150 m marker, which is exactly the marker_size in docking_params.yaml.
  Get this wrong and every PnP distance is scaled by the same error.

  Marker size is a real design trade. Too small and it is undetectable at the
  start of the approach; too large and it overflows the camera's field of view
  before the robot reaches the dock. 0.15 m works for a 1280x960 camera with an
  80 deg horizontal field of view mounted 0.183 m ahead of base_footprint.

  NOTE: the previous version used URDF-style <origin xyz rpy>, which SDF
  silently ignores - the post, the plate and the marker all collapsed onto the
  model origin and were buried in the ground plane. SDF uses <pose>.
-->
<sdf version="1.6">
  <model name="aruco_dock_station">
    <static>true</static>
    <link name="link">

      <!-- Dock post -->
      <visual name="dock_post_visual">
        <pose>0 0 0.17 0 0 0</pose>
        <geometry>
          <box><size>0.08 0.34 0.34</size></box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.17 1.0</ambient>
          <diffuse>0.25 0.25 0.28 1.0</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
        </material>
      </visual>
      <collision name="dock_post_collision">
        <pose>0 0 0.17 0 0 0</pose>
        <geometry>
          <box><size>0.08 0.34 0.34</size></box>
        </geometry>
        <surface>
          <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
        </surface>
      </collision>

      <!-- White backing board: gives the marker a clean quiet zone -->
      <visual name="marker_backing_visual">
        <pose>0.0425 0 0.162 0 0 0</pose>
        <geometry>
          <box><size>0.005 0.25 0.25</size></box>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.9 1.0</ambient>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
        </material>
      </visual>

      <!-- Marker plate: 0.1875 m wide => 0.150 m of printed marker -->
      <visual name="aruco_marker_visual">
        <pose>0.0455 0 0.162 0 0 0</pose>
        <geometry>
          <box><size>0.002 0.1875 0.1875</size></box>
        </geometry>
        <material>
          <script>
            <uri>model://aruco_dock_station/materials/scripts</uri>
            <uri>model://aruco_dock_station/materials/textures</uri>
            <name>Aruco/Marker42</name>
          </script>
          <!-- Unlit-ish so the marker stays high contrast regardless of the sun angle -->
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>

      <!-- Charging plate the robot noses up to -->
      <visual name="contact_plate_visual">
        <pose>0.0425 0 0.033 0 0 0</pose>
        <geometry>
          <box><size>0.006 0.16 0.05</size></box>
        </geometry>
        <material>
          <ambient>0.6 0.45 0.1 1.0</ambient>
          <diffuse>0.9 0.7 0.15 1.0</diffuse>
        </material>
      </visual>

    </link>
  </model>
</sdf>
