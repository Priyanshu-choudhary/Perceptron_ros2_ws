<?xml version="1.0" ?>
<!--
  GENERATED by tools/gen_world.py - edit that and re-run, do not hand-edit.

  An 8 x 6 m room with a partition, static obstacles and the ArUco dock
  against the east wall. Used for SLAM (level 2), localisation (level 3) and
  Nav2 (levels 4 onwards).

  Every obstacle stands taller than the 0.21 m lidar scan plane. Anything
  shorter is invisible to the planner, which will happily drive into it.
-->
<sdf version="1.6">
  <world name="room_world">

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>100</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <link name="link">
        <pose>0.0000 3.0750 0.6000 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>8.3000 0.1500 1.2000</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.3000 0.1500 1.2000</size></box></geometry>
          <material>
            <ambient>0.28 0.28 0.29 1</ambient>
            <diffuse>0.55 0.55 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <link name="link">
        <pose>0.0000 -3.0750 0.6000 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>8.3000 0.1500 1.2000</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.3000 0.1500 1.2000</size></box></geometry>
          <material>
            <ambient>0.28 0.28 0.29 1</ambient>
            <diffuse>0.55 0.55 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <link name="link">
        <pose>4.0750 0.0000 0.6000 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1500 6.0000 1.2000</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1500 6.0000 1.2000</size></box></geometry>
          <material>
            <ambient>0.28 0.28 0.29 1</ambient>
            <diffuse>0.55 0.55 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <link name="link">
        <pose>-4.0750 0.0000 0.6000 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1500 6.0000 1.2000</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1500 6.0000 1.2000</size></box></geometry>
          <material>
            <ambient>0.28 0.28 0.29 1</ambient>
            <diffuse>0.55 0.55 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="partition">
      <static>true</static>
      <link name="link">
        <pose>0.5000 1.9000 0.6000 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1500 2.2000 1.2000</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1500 2.2000 1.2000</size></box></geometry>
          <material>
            <ambient>0.28 0.28 0.29 1</ambient>
            <diffuse>0.55 0.55 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="crate_a">
      <static>true</static>
      <link name="link">
        <pose>1.8000 -1.2000 0.4000 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.6000 0.6000 0.8000</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6000 0.6000 0.8000</size></box></geometry>
          <material>
            <ambient>0.28 0.28 0.29 1</ambient>
            <diffuse>0.55 0.55 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="crate_b">
      <static>true</static>
      <link name="link">
        <pose>-2.2000 1.4000 0.3000 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.8000 0.4000 0.6000</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8000 0.4000 0.6000</size></box></geometry>
          <material>
            <ambient>0.28 0.28 0.29 1</ambient>
            <diffuse>0.55 0.55 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="crate_c">
      <static>true</static>
      <link name="link">
        <pose>-1.0000 -2.0000 0.5000 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.5000 0.5000 1.0000</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5000 0.5000 1.0000</size></box></geometry>
          <material>
            <ambient>0.28 0.28 0.29 1</ambient>
            <diffuse>0.55 0.55 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="pillar_a">
      <static>true</static>
      <link name="link">
        <pose>2.6000 1.6000 0.6000 0 0 0</pose>
        <collision name="collision">
          <geometry><cylinder><radius>0.2500</radius><length>1.2000</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2500</radius><length>1.2000</length></cylinder></geometry>
          <material>
            <ambient>0.23 0.20 0.17 1</ambient>
            <diffuse>0.45 0.40 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="pillar_b">
      <static>true</static>
      <link name="link">
        <pose>-3.0000 -1.0000 0.5000 0 0 0</pose>
        <collision name="collision">
          <geometry><cylinder><radius>0.2000</radius><length>1.0000</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2000</radius><length>1.0000</length></cylinder></geometry>
          <material>
            <ambient>0.23 0.20 0.17 1</ambient>
            <diffuse>0.45 0.40 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://aruco_dock_station</uri>
      <name>docking_station</name>
      <pose>3.5500 -1.8000 0.0000 0.0000 0.0000 3.1416</pose>
    </include>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>20.0</update_rate>
    </plugin>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.75 0.8 1</background>
      <shadows>true</shadows>
    </scene>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>75</iters><sor>1.3</sor></solver>
        <constraints>
          <cfm>0.0</cfm><erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>-6.5 -6.0 6.0 0 0.62 0.75</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
