  <material name="silver"><color rgba="0.700 0.700 0.700 1.000"/></material>
  <material name="black"><color rgba="0.100 0.100 0.100 1.000"/></material>
  <material name="red"><color rgba="0.800 0.150 0.150 1.000"/></material>
  <material name="blue"><color rgba="0.150 0.300 0.800 1.000"/></material>
  <material name="white"><color rgba="1.000 1.000 1.000 1.000"/></material>

</robot>
